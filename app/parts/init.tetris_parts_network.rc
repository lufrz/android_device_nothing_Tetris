# SPDX-License-Identifier: Apache-2.0

# Restore only at boot, after persistent properties are loaded. Saving a new
# selection must not enqueue another live write after the app's verified request.
on property:sys.boot_completed=1
    trigger tetris-parts-tcp-restore
    trigger tetris-parts-tcp-ready

on tetris-parts-tcp-restore && property:persist.sys.tetrisparts.tcp_congestion=reno
    write /proc/sys/net/ipv4/tcp_congestion_control reno

on tetris-parts-tcp-restore && property:persist.sys.tetrisparts.tcp_congestion=cubic
    write /proc/sys/net/ipv4/tcp_congestion_control cubic

on tetris-parts-tcp-restore && property:persist.sys.tetrisparts.tcp_congestion=bic
    write /proc/sys/net/ipv4/tcp_congestion_control bic

on tetris-parts-tcp-restore && property:persist.sys.tetrisparts.tcp_congestion=westwood
    write /proc/sys/net/ipv4/tcp_congestion_control westwood

on tetris-parts-tcp-restore && property:persist.sys.tetrisparts.tcp_congestion=htcp
    write /proc/sys/net/ipv4/tcp_congestion_control htcp

on tetris-parts-tcp-restore && property:persist.sys.tetrisparts.tcp_congestion=bbr
    write /proc/sys/net/ipv4/tcp_congestion_control bbr

on tetris-parts-tcp-restore && property:persist.sys.tetrisparts.tcp_congestion=bbr3
    write /proc/sys/net/ipv4/tcp_congestion_control bbr3

# The separate event runs after all matching restore actions. Absent/off saves
# leave the kernel default untouched; a rejected restore must not block controls.
on tetris-parts-tcp-ready
    setprop sys.tetrisparts.tcp_ready 1

on property:sys.tetrisparts.tcp_congestion=reno
    write /proc/sys/net/ipv4/tcp_congestion_control reno

on property:sys.tetrisparts.tcp_congestion=cubic
    write /proc/sys/net/ipv4/tcp_congestion_control cubic

on property:sys.tetrisparts.tcp_congestion=bic
    write /proc/sys/net/ipv4/tcp_congestion_control bic

on property:sys.tetrisparts.tcp_congestion=westwood
    write /proc/sys/net/ipv4/tcp_congestion_control westwood

on property:sys.tetrisparts.tcp_congestion=htcp
    write /proc/sys/net/ipv4/tcp_congestion_control htcp

on property:sys.tetrisparts.tcp_congestion=bbr
    write /proc/sys/net/ipv4/tcp_congestion_control bbr

on property:sys.tetrisparts.tcp_congestion=bbr3
    write /proc/sys/net/ipv4/tcp_congestion_control bbr3
