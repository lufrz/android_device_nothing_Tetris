# The kernel owns the session and clears it when the cable is disconnected.
# Grant access after charger modules load; never restore a bypass request at boot.
on property:vendor.all.modules.ready=1
    chown root system /sys/devices/platform/charger/charge_bypass
    chmod 0660 /sys/devices/platform/charger/charge_bypass
    chown root system /sys/devices/platform/charger/charge_bypass_status
    chmod 0440 /sys/devices/platform/charger/charge_bypass_status
