# SPDX-License-Identifier: Apache-2.0

system_internal_prop(tetrisparts_tcp_request_prop)
system_internal_prop(tetrisparts_tcp_status_prop)
set_prop(tetris_parts_app, tetrisparts_tcp_request_prop)
get_prop(tetris_parts_app, tetrisparts_tcp_status_prop)

neverallow { domain -init -tetris_parts_app } tetrisparts_tcp_request_prop:property_service set;
neverallow { domain -init } tetrisparts_tcp_status_prop:property_service set;

# Retain the platform proc_net_type rules for init and existing network services.
type proc_tetris_tcp_control, fs_type, proc_type, proc_net_type;
type proc_tetris_tcp_available, fs_type, proc_type, proc_net_type;
allow tetris_parts_app { proc_tetris_tcp_control proc_tetris_tcp_available }:file r_file_perms;

# Android enforces the app permissions before returning network and SIM state.
allow tetris_parts_app {
    connectivity_service
    wifi_service
    radio_service
    registry_service
}:service_manager find;
