# The app requests two fixed thermal modes; this vendor helper alone talks to MTK.
type tetris_parts_thermal, domain;
type tetris_parts_thermal_exec, exec_type, vendor_file_type, file_type;
type tetris_parts_thermal_data_file, file_type, data_file_type;
init_daemon_domain(tetris_parts_thermal)

get_prop(tetris_parts_thermal, tetrisparts_thermal_request_prop)
set_prop(tetris_parts_thermal, vendor_tetrisparts_thermal_state_prop)

allow tetris_parts_thermal thermal_socket:sock_file write;
allow tetris_parts_thermal thermal_core:unix_stream_socket connectto;
allow tetris_parts_thermal thermal_core_data_file:dir search;
allow tetris_parts_thermal thermal_core_data_file:file { open read getattr lock };
allow tetris_parts_thermal self:unix_stream_socket create_stream_socket_perms;
allow tetris_parts_thermal tetris_parts_thermal_data_file:dir rw_dir_perms;
allow tetris_parts_thermal tetris_parts_thermal_data_file:file create_file_perms;

allow vendor_init tetris_parts_thermal_data_file:dir create_dir_perms;
allow vendor_init tetris_parts_thermal_data_file:file { getattr unlink };

# No thermal sysfs/proc writes, hardware shutdown controls, or app socket access.
